  },
  "homepage": "https://github.com/risense-ai/respire-agent-plugin",
  "repository": "https://github.com/risense-ai/respire-agent-plugin",
  "license": "MIT",
  "keywords": ["memory", "recall", "rsrs", "respire", "mcp", "skill"],
  "extensions": {
    "com.risense.respire": {
      "displayName": "Respire Memory",
      "engine": "rsrs",
      "minCliVersion": "1.0.0",
      "docs": "./com.risense.respire/README.md"
    }
  }
}
